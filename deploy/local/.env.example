# cp .env.example .env — compose reads this file for both interpolation and env_file.
COMPOSE_PROJECT_NAME=ocsbx-local
OC_TAG=latest
MCP_PORT=4784
WEB_PORT=4785
OPENCODE_DISABLE_AUTOUPDATE=1
